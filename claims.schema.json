{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "periodic-net-wl-tests claims",
  "type": "object",
  "required": ["version", "release_kind", "data_source", "kinds", "scope", "not_claimed", "claims"],
  "properties": {
    "version": {"type": "string"},
    "release_kind": {"type": "array", "items": {"enum": ["data", "tool"]}, "minItems": 1},
    "data_source": {
      "type": "object",
      "required": ["name", "commit", "files", "redistributed"],
      "properties": {
        "name": {"type": "string"},
        "commit": {"type": "string"},
        "files": {"type": "array", "items": {
          "type": "object", "required": ["path", "url", "sha256", "bytes"],
          "properties": {"path": {"type": "string"}, "url": {"type": "string"},
                         "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer"},
                         "required_for": {"type": "string"}}}},
        "redistributed": {"type": "boolean"},
        "licence_found": {"type": "boolean"}
      }
    },
    "kinds": {"type": "object", "propertyNames": {"enum": ["finite-computation", "independent-implementation", "prose"]}},
    "scope": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "statement", "evidence", "reproduce"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["finite-computation", "independent-implementation", "prose"]},
          "statement": {"type": "string"},
          "cases": {"type": "integer"},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
          "reproduce": {"type": "string"},
          "qualification": {"type": "string"},
          "numbers": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256", "bytes"],
             "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            "bytes": {"type": "integer"}}}
  }
}
